      printf 'file.lua:%s:1:match\n' "$i"
      i=$((i + 1))
    done
    exec sleep 5
    ;;
  first)
    printf '%s\n' "$$" >"${RG_CANCEL_PID_FILE:?}"
    printf '%s\n' 'old.lua:1:1:old'
    exec sleep 5
    ;;
  second)
    printf '%s\n' 'new.lua:1:1:new'
