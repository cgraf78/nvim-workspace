  _assert_eq "root rg runtime: real capped producer exits with ordered bounded output" \
    "$expected" "$result"
  cap_pid=$(cat "$tmp/cap.pid")
  if kill -0 "$cap_pid" 2>/dev/null; then
    _fail "root rg runtime: capped producer was not reaped"
  else
    _pass "root rg runtime: capped producer is reaped"
  fi

  result=$(RG_CANCEL_PID_FILE="$tmp/cancel.pid" _nvim_lua "
  local grep = require('nvim_workspace.picker.grep')
  local scope = require('nvim_workspace.picker.scope')
  local generation = 1
  local visible = {}

  local function start(mode)
    local my_generation = generation
    return grep.run_root_rg({ '$tmp/stream-rg', mode }, function(lines)
      if my_generation == generation then
        visible = lines
      end
    end)
  end

  local first = start('first')
  local started = vim.wait(1000, function()
    return vim.uv.fs_stat('$tmp/cancel.pid') ~= nil
  end)
  generation = generation + 1
  scope.cancel_handle(first)
  start('second')
  local ready = vim.wait(2000, function()
    return visible[1] == 'new.lua:1:1:new'
  end)
  vim.wait(100)
  print(started)
  print(ready)
  print(#visible)
  print(visible[1])
")
  expected="$(printf 'true\ntrue\n1\nnew.lua:1:1:new')"
  _assert_eq "root rg runtime: cancellation and reopen discard stale output" \
    "$expected" "$result"
  cancel_pid=$(cat "$tmp/cancel.pid")
  if kill -0 "$cancel_pid" 2>/dev/null; then
    _fail "root rg runtime: canceled producer was not reaped"
  else
    _pass "root rg runtime: canceled producer is reaped"
  fi
else
  echo "skip: root rg runtime integration requires Neovim 0.10+"
fi
