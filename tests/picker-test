result=$(_nvim_lua '
  local killed = 0
  local system_opts
  vim.system = function(_, opts, on_exit)
    system_opts = opts
    local handle = {
      kill = function(_, signal)
        killed = signal
      end,
    }
    vim.schedule(function()
      local first = {}
      for i = 1, 150 do
        first[#first + 1] = ("file.lua:%d:1:first"):format(i)
      end
      opts.stdout(nil, table.concat(first, "\n") .. "\nfile.lua:151")
      local second = { ":1:second", "file.lua:151:9:duplicate" }
      for i = 152, 260 do
        second[#second + 1] = ("file.lua:%d:1:second"):format(i)
      end
      opts.stdout(nil, table.concat(second, "\n") .. "\n")
      opts.stdout(nil, nil)
      on_exit({ code = 143, signal = 15 })
    end)
    return handle
  end

  local grep = require("nvim_workspace.picker.grep")
  local lines
  local result_code
  grep.run_root_rg({ "rg", "query" }, function(found, result)
    lines = found
    result_code = result.code
  end)
  local ready = vim.wait(1000, function()
    return lines ~= nil
  end)
  print(ready)
  print(type(system_opts.stdout))
  print(tostring(system_opts.stdout == true))
  print(#lines)
  print(lines[1])
  print(lines[#lines])
  print(killed)
  print(result_code)
')
expected="$(printf 'true\nfunction\nfalse\n200\nfile.lua:1:1:first\nfile.lua:200:1:second\n15\n143')"
_assert_eq "root rg runtime: streams in order and terminates at the display cap" \
