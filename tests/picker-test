cat >"$tmp/slow-fd" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$$" >"${FD_PID_FILE:?}"
exec sleep 5
EOF
chmod +x "$tmp/slow-fd"
if [[ "$(_nvim_lua 'print(type(vim.system))')" == "function" ]]; then
  result=$(FD_PID_FILE="$tmp/fd.pid" _nvim_lua "
    local files = require('nvim_workspace.picker.files')
    local result
    files.run_fd({ '$tmp/slow-fd' }, vim.env.HOME, function(completed)
      result = completed
    end)
    local ready = vim.wait(3000, function()
      return result ~= nil
    end)
    print(ready)
    print(result.code)
  ")
  expected="$(printf 'true\n124')"
  _assert_eq "fd runtime: HOME timeout terminates and completes the backend" \
    "$expected" "$result"
  fd_pid=$(cat "$tmp/fd.pid")
  if kill -0 "$fd_pid" 2>/dev/null; then
    _fail "fd runtime: timed-out producer was not reaped"
  else
    _pass "fd runtime: timed-out producer is reaped"
  fi
else
  echo "skip: fd runtime timeout integration requires Neovim 0.10+"
fi

